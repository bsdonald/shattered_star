{
  "meta": {
    "name": "Shattered Star Firebase data map example",
    "version": 1,
    "timestampFormat": "ISO-8601 strings in this fixture; use Firestore Timestamp values in production",
    "designNotes": [
      "Characters are global records and join campaigns through characterParticipants.",
      "Item definitions describe item types; item instances describe actual campaign-owned items or stacks.",
      "An item instance has one current owner: either a character or a campaign DM stockpile.",
      "Inventory transfers and character movements are append-only audit records."
    ]
  },
  "recommendedDataMap": {
    "users": {
      "path": "users/{userId}",
      "purpose": "User profile and app preferences. Firebase Auth remains the source of authentication identity.",
      "keyFields": ["displayName", "email", "createdAt", "updatedAt"]
    },
    "campaigns": {
      "path": "campaigns/{campaignId}",
      "purpose": "Campaign metadata and settings.",
      "keyFields": ["name", "description", "dmUserIds", "status", "createdAt", "updatedAt"],
      "subcollections": {
        "members": {
          "path": "campaigns/{campaignId}/members/{userId}",
          "purpose": "Campaign membership and role.",
          "keyFields": ["role", "status", "joinedAt", "leftAt"]
        },
        "characterParticipants": {
          "path": "campaigns/{campaignId}/characterParticipants/{characterId}",
          "purpose": "A character's participation and campaign-specific state.",
          "keyFields": ["characterId", "ownerUserId", "status", "campaignOverrides", "joinedAt", "leftAt"]
        },
        "characterSnapshots": {
          "path": "campaigns/{campaignId}/characterSnapshots/{snapshotId}",
          "purpose": "Read-only historical state after a character leaves or changes campaign context.",
          "keyFields": ["characterId", "capturedAt", "characterState", "inventoryInstanceIds"]
        }
      }
    },
    "characters": {
      "path": "characters/{characterId}",
      "purpose": "Global character identity and reusable canonical character data.",
      "keyFields": ["playerId", "name", "race", "favoredClass", "level", "gender", "age", "height", "weight", "home", "alignment", "deity", "languages", "stats", "imageLink", "createdAt", "updatedAt"],
      "subcollections": {
        "notes": {
          "path": "characters/{characterId}/notes/{noteId}",
          "purpose": "Character notes. Store visibility as private or campaign-visible when that feature is added.",
          "keyFields": ["authorUserId", "visibility", "body", "createdAt", "updatedAt"]
        }
      }
    },
    "itemDefinitions": {
      "path": "itemDefinitions/{definitionId}",
      "purpose": "Reusable item templates, including standard or DM-created custom items.",
      "keyFields": ["name", "category", "description", "stackable", "weight"]
    },
    "itemInstances": {
      "path": "itemInstances/{instanceId}",
      "purpose": "Actual campaign-owned items or quantity stacks.",
      "keyFields": ["campaignId", "definitionId", "ownerType", "ownerId", "quantity", "state", "provenance", "createdAt", "updatedAt"],
      "ownerTypes": {
        "character": "ownerId is a characterId",
        "campaign": "ownerId is the campaignId and represents DM stock"
      }
    },
    "inventoryTransfers": {
      "path": "inventoryTransfers/{transferId}",
      "purpose": "Immutable audit trail for grants, transfers, splits, merges, and removals.",
      "keyFields": ["operationId", "campaignId", "itemInstanceId", "sourceOwner", "destinationOwner", "quantity", "initiatedBy", "createdAt"]
    },
    "characterMovements": {
      "path": "characterMovements/{movementId}",
      "purpose": "Immutable history of a character joining, leaving, or moving between campaigns.",
      "keyFields": ["operationId", "characterId", "fromCampaignId", "toCampaignId", "inventoryPolicy", "initiatedBy", "createdAt"]
    }
  },
